{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gong-go-dev",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-08",
  "workers_dev": true,
  // 미리보기 URL은 배포하지 않은 버전까지 <버전>-gong-go-dev...workers.dev로 공개한다.
  // 시크릿이 빈 채로 만들어진 버전이 그 주소로 실데이터를 내보낸 사고가 있었다(절차서 11장).
  // 명시하지 않으면 wrangler가 배포할 때마다 기본값으로 켜므로 여기에 못 박는다.
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Cloudflare Static Assets는 기본이 asset-first다. 게이트가 /와 /app.js보다 먼저 실행되게 한다.
    "run_worker_first": true
  },
  "r2_buckets": [
    {
      "binding": "DATA",
      "bucket_name": "gong-go-data"
    }
  ]
}
