{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gong-go",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-08",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // 업무 시간대 매시 갱신. 크론 식은 UTC로만 해석된다 — KST 09~18시 정각이 UTC 00~09시다.
  // 뜨는 시각이 GitHub Actions의 schedule보다 훨씬 정확해서, 당일 공고를 제때 올리려고
  // 트리거를 이쪽으로 옮겼다. 실제로 하는 일은 src/worker.js의 scheduled가 collect 워크플로를
  // workflow_dispatch로 건다(수집은 그대로 GitHub 러너에서 돈다).
  "triggers": {
    "crons": ["0 0-9 * * *"]
  },
  // 운영 Worker의 Workers AI 바인딩.
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "r2_buckets": [
    {
      "binding": "DATA",
      "bucket_name": "gong-go-data"
    }
  ]
}
