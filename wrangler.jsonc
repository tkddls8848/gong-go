{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gong-go-dev",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-08",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "r2_buckets": [
    {
      "binding": "DATA",
      "bucket_name": "gong-go-data"
    }
  ]
}
