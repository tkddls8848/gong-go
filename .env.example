# 로컬 실행용 환경변수. 이 파일을 .env로 복사해 채운다.
# 로컬 스크립트는 루트의 .env를 읽고, 이미 설정된 환경변수가 있으면 그 값을 먼저 쓴다.

# ── 수집(collector/) ─────────────────────────────────────────────
# 공공데이터포털 일반 인증키(포털이 발급한 키 그대로. 인코딩·디코딩 구분 없음)
DATA_GO_KR_SERVICE_KEY=

# ── R2 업로드(uploader/, collector/restore-r2.js) ─────────────────
# 토큰은 버킷 한정 Object Read & Write로 발급한다.
# R2_ENDPOINT_URL은 대시보드 R2 > 개요의 S3 API 주소를 그대로 넣는다.
# 예: https://<계정ID>.r2.cloudflarestorage.com (뒤에 버킷 경로가 붙어 있어도 된다)
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ── 분석(analyzer/) ──────────────────────────────────────────────
# --provider anthropic으로 실행할 때만 필요하다. 기본 provider인 ollama는 키가 필요 없다.
ANTHROPIC_API_KEY=

# ── Worker 전용 시크릿 ───────────────────────────────────────────
# GATE_PASSWORD, AI_ANALYSIS_PASSWORD, GITHUB_PAT_TOKEN은 Worker만 읽으므로 이 파일에 두지 않는다.
# `npx wrangler secret put <이름>`으로 Cloudflare에만 등록하고, 원본 값은 비밀번호 관리자에 보관한다.
# 위의 DATA_GO_KR_SERVICE_KEY는 수집기와 Worker(/api/live)가 함께 쓰므로 여기와 Worker 양쪽에 둔다.
