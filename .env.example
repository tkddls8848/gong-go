# 로컬 실행용 환경변수. 이 파일을 .env로 복사해 채운다.
# 로컬 스크립트는 루트의 .env를 읽고, 이미 설정된 환경변수가 있으면 그 값을 먼저 쓴다.

# ── 수집(collector/) ─────────────────────────────────────────────
# 공공데이터포털 일반 인증키(포털이 발급한 키 그대로. 인코딩·디코딩 구분 없음)
DATA_GO_KR_SERVICE_KEY=

# 수집 요청을 내보낼 곳. 비우면 apis.data.go.kr을 직접 부른다(국내에서는 이대로 된다).
# GitHub Actions 러너는 apis.data.go.kr에 TCP 연결이 되지 않으므로 Worker 중계를 거친다.
# DATA_GO_KR_RELAY_URL에는 /api/relay 까지 넣고, DATA_GO_KR_RELAY_TOKEN은 Worker 시크릿과 같은 값이어야 한다.
DATA_GO_KR_RELAY_URL=
DATA_GO_KR_RELAY_TOKEN=

# ── R2 업로드(uploader/, collector/restore-r2.js) ─────────────────
# 토큰은 버킷 한정 Object Read & Write로 발급한다.
# R2_ACCOUNT_ID는 계정 ID 32자리만 넣는다 — 대시보드가 보여 주는 S3 API 주소
# https://<여기 32자리>.r2.cloudflarestorage.com 의 가운데 부분이다.
# 주소를 통째로 쓰고 싶으면 R2_ACCOUNT_ID 대신 R2_ENDPOINT에 전체 URL을 넣는다.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT=

# ── 분석(analyzer/) ──────────────────────────────────────────────
# --provider anthropic으로 실행할 때만 필요하다. 기본 provider인 ollama는 키가 필요 없다.
ANTHROPIC_API_KEY=

# ── Worker 전용 시크릿 ───────────────────────────────────────────
# GATE_PASSWORD, AI_ANALYSIS_PASSWORD, GITHUB_PAT_TOKEN은 Worker만 읽으므로 이 파일에 두지 않는다.
# `npx wrangler secret put <이름>`으로 Cloudflare에만 등록하고, 원본 값은 비밀번호 관리자에 보관한다.
# 위의 DATA_GO_KR_SERVICE_KEY는 수집기와 Worker(/api/live)가 함께 쓰므로 여기와 Worker 양쪽에 둔다.
# DATA_GO_KR_RELAY_TOKEN은 Worker와 GitHub Actions 시크릿에 두고, 국내 로컬에서는 비워 둔다.
