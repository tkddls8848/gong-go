# 공공데이터포털 일반 인증키(Decoding)
SERVICE_KEY=

# 로컬 서버 포트 (devserver/server.js)
PORT=8788

# 조회 화면 접근 암호. 배포본은 이 파일이 아니라 Cloudflare 시크릿을 쓴다
# (npx wrangler secret put GATE_PASSWORD 또는 대시보드).
# 여기 값은 `npm run worker:dev`(wrangler dev)에만 쓰인다.
#
# 비워 두면 src/worker.js가 통과 모드로 떨어져 로컬 Worker가 게이트 없이 뜬다.
# 그러면 "로컬에선 되는데 배포본만 열려 있는" 상황을 로컬에서 잡을 수 없으므로
# 아무 값이든 채워 두는 것을 권한다. devserver(npm run serve)는 게이트가 없어 무관하다.
GATE_PASSWORD=
# 인증 쿠키 이름. 비우면 gong_gate
# GATE_COOKIE_NAME=

# Cloudflare R2 업로드(uploader/upload.js). 토큰은 버킷 한정 Object Read & Write로 발급한다.
# R2_ACCOUNT_ID는 계정 ID 32자리만 넣는다 — 대시보드가 보여 주는 S3 API 주소
# https://<여기 32자리>.r2.cloudflarestorage.com 의 가운데 부분이다.
# 주소를 통째로 쓰고 싶으면 R2_ACCOUNT_ID 대신 R2_ENDPOINT에 전체 URL을 넣는다.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT=
# R2_BUCKET=gong-go-data