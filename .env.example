# 공공데이터포털 일반 인증키(Decoding)
SERVICE_KEY=

# 수집 요청을 내보낼 곳. 비우면 apis.data.go.kr을 직접 부른다(국내에서는 이대로 된다).
# GitHub Actions 러너는 apis.data.go.kr에 TCP 연결이 되지 않으므로 Worker 중계를 거친다.
# API_BASE에는 /api/relay 까지 넣고, RELAY_TOKEN은 Worker에 등록한 값과 같아야 한다.
#   wrangler secret put RELAY_TOKEN
API_BASE=
RELAY_TOKEN=

# 로컬 서버 포트 (devserver/server.js)
PORT=8788

# 조회 화면 접근 암호. 배포본에는 Cloudflare 시크릿으로 등록한다.
GATE_PASSWORD=
# 배포 웹의 갱신 버튼이 collect.yml을 실행할 때 사용한다.
# GitHub fine-grained PAT: gong-go 저장소의 Actions read/write 권한만 부여한다.
GITHUB_TOKEN=

# Cloudflare R2 업로드(uploader/upload.js). 토큰은 버킷 한정 Object Read & Write로 발급한다.
# R2_ACCOUNT_ID는 계정 ID 32자리만 넣는다 — 대시보드가 보여 주는 S3 API 주소
# https://<여기 32자리>.r2.cloudflarestorage.com 의 가운데 부분이다.
# 주소를 통째로 쓰고 싶으면 R2_ACCOUNT_ID 대신 R2_ENDPOINT에 전체 URL을 넣는다.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT=
