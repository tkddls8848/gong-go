# 로컬 실행용 환경변수. 이 파일을 .env로 복사해 채운다.
# 로컬 스크립트는 루트의 .env를 읽고, 이미 설정된 환경변수가 있으면 그 값을 먼저 쓴다.

# ── 수집(collector/) ─────────────────────────────────────────────
# 공공데이터포털 일반 인증키(포털이 발급한 키 그대로. 인코딩·디코딩 구분 없음)
DATA_GO_KR_SERVICE_KEY=

# 수집 요청을 내보낼 곳. 비우면 apis.data.go.kr을 직접 부른다(국내에서는 이대로 된다).
# GitHub Actions 러너는 apis.data.go.kr에 TCP 연결이 되지 않으므로 Worker 중계를 거친다.
# API_BASE에는 /api/relay 까지 넣고, RELAY_TOKEN은 Worker 시크릿과 같은 값이어야 한다.
API_BASE=
RELAY_TOKEN=

# ── R2 업로드(uploader/, collector/restore-r2.js) ─────────────────
# 토큰은 버킷 한정 Object Read & Write로 발급한다.
# R2_ACCOUNT_ID는 계정 ID 32자리만 넣는다 — 대시보드가 보여 주는 S3 API 주소
# https://<여기 32자리>.r2.cloudflarestorage.com 의 가운데 부분이다.
# 주소를 통째로 쓰고 싶으면 R2_ACCOUNT_ID 대신 R2_ENDPOINT에 전체 URL을 넣는다.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT=

# ── 분석(analyzer/) ──────────────────────────────────────────────
# --provider anthropic으로 실행할 때만 필요하다. 기본 provider인 ollama는 키가 필요 없다.
ANTHROPIC_API_KEY=

# ── Worker 시크릿 ───────────────────────────────────────────────
# 아래 값은 로컬 스크립트가 읽지 않는다. 여기에 적어도 배포본에는 적용되지 않으므로
# 값마다 `npx wrangler secret put <이름>`으로 등록한다.
# RELAY_TOKEN(수집 중계)과 DATA_GO_KR_SERVICE_KEY(/api/live 최신 공고 합치기)도 같은 방법으로 Worker에 등록한다.

# 조회 화면 접근 암호
GATE_PASSWORD=
# AI 분석 전용 암호(16자 이상). 사이트 조회 암호와 다르게 설정한다.
# 미설정 시 ECR 분석과 자연어 검색의 AI 호출은 잠긴다.
AI_ANALYSIS_PASSWORD=
# 배포 화면의 갱신 버튼이 collect.yml을 실행할 때 쓴다.
# GitHub fine-grained PAT: gong-go 저장소의 Actions read/write 권한만 부여한다.
GITHUB_PAT_TOKEN=
