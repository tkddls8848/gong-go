{
  "name": "gong-go",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "deploy": "wrangler deploy",
    "collect": "node collector/collector.js",
    "compact": "node collector/compact.js",
    "upload": "node uploader/upload.js",
    "attachments": "node downloader/attachments.js",
    "analyze": "node analyzer/analyze.js",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test",
    "test:browser": "node tools/browser-smoke.cjs",
    "test:search-load": "node tools/search-benchmark.cjs",
    "test:runtime": "node tools/runtime-smoke.cjs",
    "test:runtime-browser": "node tools/runtime-smoke.cjs --browser-auth",
    "test:selection": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/eval-selection.mjs --strict"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "miniflare": "5.20261110.1-beta",
    "playwright-core": "^1.63.0",
    "wrangler": "4.160.1"
  }
}
